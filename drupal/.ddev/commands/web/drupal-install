#!/bin/bash

## Description: Installs Drupal with Tome.
## Usage: drupal-install
## Example: "ddev drupal-install"

# Fail fast: a failed step must fail the whole install, not leave a
# half-provisioned site that later commands "fix" silently.
set -euo pipefail

# Every path below is absolute and derived here, because this script runs
# under both DDEV and Lando, which mount the project at different paths
# and hand the script different working directories.
if [ -f /var/www/html/composer.json ]; then
  PROJECT_ROOT=/var/www/html            # DDEV
  # DDEV writes settings.ddev.php with the database credentials, so
  # site-install finds them by itself.
  DB_URL_ARG=""
elif [ -f /app/composer.json ]; then
  PROJECT_ROOT=/app                     # Lando
  # Lando writes no Drupal settings at all - without credentials the
  # install drops into an interactive database prompt and dies. These
  # are the drupal11 recipe's documented defaults.
  DB_URL_ARG="--db-url=mysql://drupal11:drupal11@database/drupal11"
else
  PROJECT_ROOT="$(pwd)"
  DB_URL_ARG=""
fi
DRUPAL_ROOT="$PROJECT_ROOT/web"

# Install composer dependencies.
composer install --working-dir="$PROJECT_ROOT"

# Install Drupal directly from the committed config (adopts its site UUID -
# a plain `tome:install` does site-install then a separate config:import,
# which fails with "Site UUID in source storage does not match the target
# storage" since a fresh site-install generates its own random UUID first).
drush -r "$DRUPAL_ROOT" -y site-install --existing-config ${DB_URL_ARG:+"$DB_URL_ARG"}

# Import Tome-tracked content and files (config was already handled above).
drush -r "$DRUPAL_ROOT" -y tome:import
